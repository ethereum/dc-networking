+    guint32 ssthresh = MAX(reno->ssthresh, old.ssthresh);
+    guint32 cwnd = MAX(tcp_cong(tcp)->cwnd, saved->cwnd);
+    *reno = old;
+    reno->ssthresh = ssthresh;
+    tcp_cong(tcp)->cwnd = cwnd;
+}
