+/* rtt5: Linux's tcp_cwnd_restart after an idle period of more than one RTO */
+static void _tcp_rtt5Restart(TCP* tcp, gint64 idle, gint64 rto) {
+    guint32 before = tcp->cong.cwnd;
+    guint32 ssBefore = tcp->cong.hooks->tcp_cong_ssthresh(tcp);
+    char phaseBefore = tcp_cong_reno_phase(tcp);
+    guint32 cwnd = before;
+    guint32 restart = MIN((guint32)10, before);
+    gint64 delta = idle;
+    while ((delta -= rto) > 0 && cwnd > restart) {
+        cwnd >>= 1;
+    }
+    cwnd = MAX(cwnd, restart);
+    tcp_cong_reno_restart(tcp, cwnd);
+    tcp->rtt5.restarts++;
+    if (_tcp_diagLog()) {
+        info("tcpd ssr %p idle %" G_GINT64_FORMAT " rto %" G_GINT64_FORMAT " cwnd %u %u ssthresh %u %u phase %c %c",
+             (void*)tcp, idle / SIMTIME_ONE_MILLISECOND, rto / SIMTIME_ONE_MILLISECOND, before,
+             (unsigned)tcp->cong.cwnd, ssBefore, (unsigned)tcp->cong.hooks->tcp_cong_ssthresh(tcp), phaseBefore,
+             tcp_cong_reno_phase(tcp));
+    }
+}
