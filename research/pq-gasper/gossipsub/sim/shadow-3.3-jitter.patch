         // delay the packet until the next round
         let mut deliver_time = current_time + delay;
+        // jitter: an extra exponential delay with the path's mean, kept FIFO per destination so
+        // packets of a flow are never reordered (it acts like a variable queue, not a shuffle)
+        let jitter = Worker::with(|w| w.shared.jitter_ns(src_ip, dst_ip).unwrap()).unwrap();
+        if jitter > 0 && !is_bootstrapping {
+            let u: f64 = src_host.random_mut().random();
+            let extra = (-(jitter as f64) * (1.0 - u).ln()) as u64;
+            deliver_time = src_host.jitter_fifo(dst_ip, deliver_time + SimulationTime::from_nanos(extra));
+        }
         if deliver_time < round_end_time {
             deliver_time = round_end_time;
         }
