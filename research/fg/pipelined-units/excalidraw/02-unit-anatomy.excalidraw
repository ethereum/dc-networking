   "link": null,
   "locked": false,
   "text": "voters sign the FG vote and gossip it on their subnet;\naggregators collect for a full 4 s — as today",
   "fontSize": 13,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "voters sign the FG vote and gossip it on their subnet;\naggregators collect for a full 4 s — as today",
   "autoResize": true,
   "lineHeight": 1.35
  },
  {
   "id": "unit-anatomy-0013",
